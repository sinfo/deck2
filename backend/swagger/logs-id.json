{
  "get": {
    "tags": ["logs"],
    "summary": "Get log by id",
    "operationId": "getLog",
    "consumes": ["multipart/form-data"],
    "produces": ["application/json"],
    "security": [{ "Bearer": [] }],
    "parameters": [
      { "name": "id", "in": "path", "required": true, "type": "string" }
    ],
    "responses": {
      "200": {
        "description": "Log",
        "schema": { "$ref": "./models/log.json" }
      },
      "404": { "description": "Log not found" },
      "401": { "description": "Unauthorized" }
    }
  }
}
