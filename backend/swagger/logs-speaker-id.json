{
  "get": {
    "tags": ["logs", "speakers"],
    "summary": "Get logs for a speaker",
    "operationId": "getLogsBySpeaker",
    "consumes": ["multipart/form-data"],
    "produces": ["application/json"],
    "security": [{ "Bearer": [] }],
    "parameters": [
      { "name": "id", "in": "path", "required": true, "type": "string" },
      { "name": "event", "in": "query", "type": "integer", "format": "int32" },
      { "name": "limit", "in": "query", "type": "integer", "format": "int32" },
      { "name": "skip", "in": "query", "type": "integer", "format": "int32" }
    ],
    "responses": {
      "200": {
        "description": "Logs for speaker",
        "schema": { "type": "array", "items": { "$ref": "./models/log.json" } }
      },
      "417": { "description": "Unable to get logs" },
      "400": { "description": "Invalid speaker ID" },
      "401": { "description": "Unauthorized" }
    }
  }
}
