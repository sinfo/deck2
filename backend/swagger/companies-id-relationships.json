{
    "get": {
        "tags": [
            "companies"
        ],
        "summary": "Gets a company's relationships with other companies, with each related company's name and image",
        "operationId": "getCompanyRelationships",
        "produces": [
            "application/json"
        ],
        "security": [
            {
                "Bearer": []
            }
        ],
        "parameters": [
            {
                "in": "path",
                "name": "id",
                "description": "ID of the company",
                "required": true,
                "type": "string"
            }
        ],
        "responses": {
            "200": {
                "description": "Company's relationships",
                "schema": {
                    "type": "array",
                    "items": {
                        "$ref": "./models/related-company.json"
                    }
                }
            },
            "400": {
                "description": "Invalid company ID"
            },
            "401": {
                "description": "Unauthorized"
            },
            "404": {
                "description": "Couldn't find company"
            }
        }
    },
    "post": {
        "tags": [
            "companies"
        ],
        "summary": "Adds a relationship to a company, and its inverse to the related company",
        "operationId": "addCompanyRelationship",
        "consumes": [
            "application/json"
        ],
        "produces": [
            "application/json"
        ],
        "security": [
            {
                "Bearer": []
            }
        ],
        "parameters": [
            {
                "in": "path",
                "name": "id",
                "description": "ID of the company",
                "required": true,
                "type": "string"
            },
            {
                "in": "body",
                "name": "payload",
                "description": "Relationship to add",
                "required": true,
                "schema": {
                    "$ref": "./models/company-relationship.json"
                }
            }
        ],
        "responses": {
            "200": {
                "description": "Updated company",
                "schema": {
                    "$ref": "./models/company.json"
                }
            },
            "400": {
                "description": "Invalid payload, or relationship with itself"
            },
            "401": {
                "description": "Unauthorized"
            },
            "404": {
                "description": "Couldn't find company or related company"
            },
            "409": {
                "description": "Relationship already exists, or would create a cycle"
            }
        }
    }
}
