{
    "put": {
        "tags": [
            "companies"
        ],
        "summary": "Updates the date of a relationship, on both the company and the related company",
        "operationId": "updateCompanyRelationship",
        "consumes": [
            "application/json"
        ],
        "produces": [
            "application/json"
        ],
        "security": [
            {
                "Bearer": []
            }
        ],
        "parameters": [
            {
                "in": "path",
                "name": "id",
                "description": "ID of the company",
                "required": true,
                "type": "string"
            },
            {
                "in": "path",
                "name": "targetID",
                "description": "ID of the related company",
                "required": true,
                "type": "string"
            },
            {
                "in": "query",
                "name": "type",
                "description": "Type of the relationship, as seen from the company",
                "required": true,
                "type": "string",
                "enum": [
                    "SUBSIDIARY_OF",
                    "PARENT_OF",
                    "MERGED_INTO",
                    "ABSORBED",
                    "REBRANDED_TO",
                    "REBRANDED_FROM"
                ]
            },
            {
                "in": "body",
                "name": "payload",
                "description": "New date of the relationship. A null since removes the date.",
                "required": true,
                "schema": {
                    "type": "object",
                    "properties": {
                        "since": {
                            "type": "string",
                            "format": "date-time"
                        }
                    }
                }
            }
        ],
        "responses": {
            "200": {
                "description": "Updated company",
                "schema": {
                    "$ref": "./models/company.json"
                }
            },
            "400": {
                "description": "Invalid ID, relationship type or payload"
            },
            "401": {
                "description": "Unauthorized"
            },
            "404": {
                "description": "Couldn't find company or relationship"
            }
        }
    },
    "delete": {
        "tags": [
            "companies"
        ],
        "summary": "Removes a relationship from a company, and its inverse from the related company",
        "operationId": "removeCompanyRelationship",
        "produces": [
            "application/json"
        ],
        "security": [
            {
                "Bearer": []
            }
        ],
        "parameters": [
            {
                "in": "path",
                "name": "id",
                "description": "ID of the company",
                "required": true,
                "type": "string"
            },
            {
                "in": "path",
                "name": "targetID",
                "description": "ID of the related company",
                "required": true,
                "type": "string"
            },
            {
                "in": "query",
                "name": "type",
                "description": "Type of the relationship, as seen from the company",
                "required": true,
                "type": "string",
                "enum": [
                    "SUBSIDIARY_OF",
                    "PARENT_OF",
                    "MERGED_INTO",
                    "ABSORBED",
                    "REBRANDED_TO",
                    "REBRANDED_FROM"
                ]
            }
        ],
        "responses": {
            "200": {
                "description": "Updated company",
                "schema": {
                    "$ref": "./models/company.json"
                }
            },
            "400": {
                "description": "Invalid ID or relationship type"
            },
            "401": {
                "description": "Unauthorized"
            },
            "404": {
                "description": "Couldn't find company or relationship"
            }
        }
    }
}
